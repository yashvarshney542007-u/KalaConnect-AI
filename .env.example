# KalaConnect AI — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# API key used to authenticate requests to the AI endpoints.
# Accepted via:  Authorization: Bearer <API_KEY>
# Generate a strong random key, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
KALACONNECT_AI_API_KEY=your-secret-api-key-here
