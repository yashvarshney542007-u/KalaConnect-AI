# Virtual environments
venv/
.venv/

# Python
__pycache__/
*.py[cod]
*.pyo

# Environment variables
.env
.env.*

# IDE
.vscode/
.idea/

# Hugging Face / ML cache
.cache/
huggingface/

# Model weights (do NOT commit these)
*.pt
*.pth
*.bin
*.safetensors
*.onnx

# Whisper model cache
whisper_cache/

# Test media (audio / images — must not be committed)
tests/fixtures/audio/*
!tests/fixtures/audio/.gitkeep
tests/fixtures/images/*
!tests/fixtures/images/.gitkeep
*.wav
*.mp3
*.flac
*.ogg
*.webm
*.jpg
*.jpeg
*.png
*.webp

# Evaluation data (images and auto-generated results)
evaluation/images/*
!evaluation/images/.gitkeep
evaluation/results/*
!evaluation/results/.gitkeep

# Logs
*.log

# pytest
.pytest_cache/
.coverage
htmlcov/

# OS
.DS_Store
Thumbs.db